<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro calendar-intro"><div><p class="muted">See the shape of your commitments.</p></div><div class="calendar-nav"><a class="icon-button" href="/calendar?year=<%= month===0?year-1:year %>&month=<%= month===0?11:month-1 %>"><i data-lucide="chevron-left"></i></a><strong><%= label %></strong><a class="icon-button" href="/calendar?year=<%= month===11?year+1:year %>&month=<%= month===11?0:month+1 %>"><i data-lucide="chevron-right"></i></a></div><button class="button primary" data-command="new-task"><i data-lucide="plus"></i> New task</button></div><section class="panel calendar-panel"><div class="weekday-row"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div><div class="calendar-grid"><% days.forEach(cell=>{ %><div class="calendar-cell <%= cell?'':'blank' %>"><% if(cell){ %><span class="calendar-day"><%= cell.day %></span><% cell.tasks.slice(0,3).forEach(task=>{ %><div class="calendar-task <%= task.priority %>"><%= task.title %></div><% }) } %></div><% }) %></div></section></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script></body></html>