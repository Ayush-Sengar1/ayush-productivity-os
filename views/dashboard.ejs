<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content dashboard-content"><div class="welcome-row"><div><p class="welcome-text">Good to see you, <strong><%= currentUser?.name?.split(' ')[0] %></strong>.</p><p class="muted">Here is your path through the day.</p></div><button class="button primary" data-command="new-task"><i data-lucide="plus"></i> New task</button></div><div class="stat-grid"><article class="stat-card stat-focus"><div class="stat-icon"><i data-lucide="sun"></i></div><span>Due today</span><strong><%= summary.dueToday.length %></strong><small><%= summary.overdue.length %> overdue · <%= summary.completedToday.length %> completed</small></article><article class="stat-card"><div class="stat-icon green"><i data-lucide="check-check"></i></div><span>Completed this week</span><strong><%= summary.completedWeek.length %></strong><small>Keep the momentum going</small></article><article class="stat-card"><div class="stat-icon purple"><i data-lucide="target"></i></div><span>Productivity score</span><strong><%= analyticsData.score %><small class="score-max">/100</small></strong><small><%= analyticsData.score>=70?'You are building a strong rhythm':'A few focused wins can shift the day' %></small></article><article class="stat-card"><div class="stat-icon orange"><i data-lucide="flame"></i></div><span>Habit consistency</span><strong><%= analyticsData.habits.rate %><small class="score-max">%</small></strong><small><%= analyticsData.habits.done %> of <%= analyticsData.habits.total %> due today</small></article></div><div class="dashboard-grid"><section class="panel today-panel"><div class="panel-heading"><div><span class="eyebrow">Today</span><h2>Your focus list</h2></div><a href="/tasks" class="text-link">View all <i data-lucide="arrow-up-right"></i></a></div><div class="task-list"><% if(!summary.dueToday.length){ %><div class="empty-state"><span class="empty-icon"><i data-lucide="check"></i></span><h3>Nothing urgent today</h3><p>You have room to move one meaningful thing forward.</p><button class="button secondary" data-command="new-task">Add a task</button></div><% } summary.dueToday.slice(0,5).forEach(task=>{ %><%- include('partials/task-row',{task}) %><% }) %></div></section><section class="panel score-panel"><div class="panel-heading"><div><span class="eyebrow">Productivity</span><h2>Today at a glance</h2></div><a href="/analytics" class="round-link"><i data-lucide="arrow-up-right"></i></a></div><div class="score-ring" style="--score:<%= analyticsData.score %>"><div><strong><%= analyticsData.score %></strong><span>score</span></div></div><div class="score-breakdown"><% analyticsData.breakdown.slice(0,3).forEach(item=>{ %><div><span><i class="tone-dot <%= item.tone %>"></i><%= item.label %></span><strong class="<%= item.tone %>"><%= item.value>0?'+':'' %><%= item.value %></strong></div><% }) %></div></section><section class="panel goals-panel"><div class="panel-heading"><div><span class="eyebrow">Direction</span><h2>Active goals</h2></div><a href="/goals" class="text-link">See goals <i data-lucide="arrow-up-right"></i></a></div><div class="goal-list"><% if(!goals.length){ %><div class="empty-inline">Create a goal to give your tasks a direction.</div><% } goals.forEach(goal=>{ %><div class="goal-item"><div class="goal-item-top"><span class="goal-symbol"><i data-lucide="target"></i></span><div><strong><%= goal.title %></strong><small><%= goal.category %></small></div><b><%= goal.progress||0 %>%</b></div><div class="progress-track"><span style="width:<%= goal.progress||0 %>%"></span></div></div><% }) %></div></section><section class="panel upcoming-panel"><div class="panel-heading"><div><span class="eyebrow">Next up</span><h2>Upcoming</h2></div><a href="/calendar" class="round-link"><i data-lucide="arrow-up-right"></i></a></div><div class="upcoming-list"><% if(!summary.upcoming.length){ %><div class="empty-inline">Your future is pleasantly open.</div><% } summary.upcoming.forEach(task=>{ %><div class="upcoming-item"><div class="date-chip"><strong><%= new Date(task.dueDate).getDate() %></strong><small><%= new Date(task.dueDate).toLocaleString('en-IN',{month:'short'}) %></small></div><div><strong><%= task.title %></strong><small><%= task.category||'Task' %> · <%= task.priority %> priority</small></div></div><% }) %></div></section></div><div class="lower-grid"><section class="panel habits-panel"><div class="panel-heading"><div><span class="eyebrow">Consistency</span><h2>Today’s habits</h2></div><a href="/habits" class="text-link">Open tracker <i data-lucide="arrow-up-right"></i></a></div><div class="habit-list"><% if(!habits.length){ %><div class="empty-inline">Add a habit you want to make automatic.</div><% } habits.slice(0,4).forEach(h=>{ %><div class="habit-item"><button class="habit-check <%= h.completedToday?'done':'' %>" data-habit-id="<%= h._id %>" title="Mark complete"><i data-lucide="check"></i></button><div><strong><%= h.name %></strong><small><%= h.currentStreak %> day streak · <%= h.completionPercent %>% this month</small></div><span class="habit-bar"><i style="width:<%= h.completionPercent %>%"></i></span></div><% }) %></div></section><section class="panel activity-panel"><div class="panel-heading"><div><span class="eyebrow">Activity</span><h2>Recent movement</h2></div></div><div class="activity-list"><% if(!activities.length){ %><div class="empty-inline">Your activity trail will appear here.</div><% } activities.slice(0,5).forEach(item=>{ %><div class="activity-item"><span class="activity-dot"></span><div><strong><%= item.message %></strong><small><%= new Date(item.createdAt).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'numeric',minute:'2-digit'}) %></small></div></div><% }) %></div></section></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script>window.FOCUS_DATA=<%- JSON.stringify({trend:analyticsData.trend}) %></script><script src="/js/dashboard.js"></script></body></html>