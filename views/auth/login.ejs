<%- include('../partials/head') %><main class="auth-page"><div class="auth-decoration"></div><section class="auth-card"><a class="brand auth-brand" href="/"><span class="brand-mark"><i data-lucide="sparkles"></i></span><span>Focus<span class="brand-dot">.</span></span></a><div class="auth-copy"><span class="eyebrow">Welcome back</span><h1>Make space for<br><em>meaningful work.</em></h1><p>Plan the day. Protect your focus. Make steady progress on the goals that matter.</p></div><% if(error){ %><div class="form-error"><i data-lucide="alert-circle"></i><%= error %></div><% } %><form method="post" action="/login" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><label>Email<input type="email" name="email" required value="<%= form?.email||'' %>" placeholder="you@example.com"></label><label>Password<div class="password-wrap"><input type="password" name="password" required placeholder="Your password"><i data-lucide="eye"></i></div></label><button class="button primary full-button">Log in <i data-lucide="arrow-right"></i></button></form><p class="auth-switch">New to Focus? <a href="/register">Create an account</a></p></section><div class="auth-quote"><span class="quote-mark">“</span><p>Small steps, repeated consistently, become remarkable progress.</p><span class="quote-author">A calmer way to get things done.</span></div></main><%- include('../partials/flash') %><script>lucide.createIcons();</script></body></html>
