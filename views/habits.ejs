<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Consistency compounds. Make the next repetition easy.</p></div><button class="button primary" data-open-inline="habit-form"><i data-lucide="plus"></i> New habit</button></div><section id="habit-form" class="panel inline-form-panel hidden"><form class="quick-entity-form" data-entity="habit"><input name="name" placeholder="Habit name, e.g. Study JavaScript" required><select name="frequency"><option value="daily">Every day</option><option value="weekly">Every week</option></select><button class="button primary">Create habit</button></form></section><div class="habit-page-grid"><% if(!habits.length){ %><div class="panel empty-state"><span class="empty-icon"><i data-lucide="flame"></i></span><h3>Build your first streak</h3><p>Choose one small behavior you want to make automatic.</p></div><% } habits.forEach(h=>{ %><article class="habit-card panel"><div class="habit-card-top"><span class="habit-symbol"><i data-lucide="flame"></i></span><span class="streak-badge"><i data-lucide="zap"></i><%= h.currentStreak %> day streak</span></div><h2><%= h.name %></h2><p><%= h.description||'A small promise to your future self.' %></p><div class="habit-stats"><div><strong><%= h.completionPercent %>%</strong><span>This month</span></div><div><strong><%= h.bestStreak %></strong><span>Best streak</span></div><button class="habit-check large <%= h.completedToday?'done':'' %>" data-habit-id="<%= h._id %>"><i data-lucide="check"></i><span><%= h.completedToday?'Done today':'Complete today' %></span></button></div></article><% }) %></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/entities.js"></script></body></html>