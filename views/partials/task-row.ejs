<div class="task-row"><button class="task-check" data-task-id="<%= task._id %>" title="Complete task"><i data-lucide="check"></i></button><div class="task-copy"><strong><%= task.title %></strong><div><% if(task.tags?.length){ task.tags.slice(0,2).forEach(tag=>{ %><span class="tag">#<%= tag %></span><% }) } %><span class="task-meta"><%= task.dueTime||'Today' %></span></div></div><span class="priority-dot <%= task.priority %>" title="<%= task.priority %> priority"></span></div>