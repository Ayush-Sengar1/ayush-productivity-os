<div id="toast" class="toast" role="status"></div><div id="command-palette" class="palette-backdrop" aria-hidden="true"><div class="command-palette"><div class="palette-search"><i data-lucide="search"></i><input id="palette-input" placeholder="Search commands..." autocomplete="off"><kbd>ESC</kbd></div><div class="palette-options"><button data-command="new-task"><i data-lucide="plus"></i><span>Create task</span><kbd>N</kbd></button><a href="/search"><i data-lucide="search"></i><span>Search workspace</span><kbd>/</kbd></a><a href="/goals"><i data-lucide="target"></i><span>Open goals</span></a><a href="/milestones"><i data-lucide="flag"></i><span>Open milestones</span></a><a href="/habits"><i data-lucide="flame"></i><span>Track habits</span></a><a href="/calendar"><i data-lucide="calendar-days"></i><span>Open calendar</span></a><a href="/analytics"><i data-lucide="chart-no-axes-combined"></i><span>View analytics</span></a></div></div></div><div id="notifications-panel" class="notifications-panel" aria-hidden="true"><div class="notifications-heading"><div><span class="eyebrow">Workspace</span><h3>Notifications</h3></div><div><button class="text-button" data-notifications-read-all>Mark all read</button><button class="icon-button" data-close-notifications aria-label="Close notifications"><i data-lucide="x"></i></button></div></div><div id="notification-list" class="notification-list"></div></div><div id="task-modal" class="modal-backdrop" aria-hidden="true"><section class="modal"><div class="modal-heading"><div><span class="eyebrow">Quick capture</span><h2>Create a task</h2></div><button class="icon-button" data-close-modal aria-label="Close task dialog"><i data-lucide="x"></i></button></div><form id="quick-task-form" class="form-grid"><label class="full">What needs to be done?<input name="title" required maxlength="180" placeholder="e.g. Finish resume tomorrow at 7pm #career high"></label><label>Description<textarea name="description" rows="3" placeholder="Add context, notes, or the intended outcome"></textarea></label><label>Task type<select name="taskType"><option value="one_time">One-time</option><option value="short_term">Short-term</option><option value="recurring">Recurring</option><option value="milestone">Milestone</option><option value="habit">Habit task</option></select></label><label>Due date<input type="date" name="dueDate"></label><label>Due time<input type="time" name="dueTime"></label><label>Priority<select name="priority"><option value="medium">Medium</option><option value="high">High</option><option value="critical">Critical</option><option value="low">Low</option></select></label><label class="full">Tags<input name="tags" placeholder="career, study"></label><label class="check-field"><input type="checkbox" name="reminderEnabled"> Add an in-app reminder</label><label>Minutes before<select name="reminderMinutes"><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="60">1 hour</option><option value="1440">1 day</option></select></label><label class="check-field"><input type="checkbox" name="recurrenceEnabled"> Repeat this task</label><label>Repeat frequency<select name="recurrenceFrequency"><option value="daily">Every day</option><option value="weekdays">Weekdays</option><option value="weekly">Every week</option><option value="biweekly">Every 2 weeks</option><option value="monthly">Every month</option><option value="yearly">Every year</option></select></label><div class="modal-actions full"><button type="button" class="button secondary" data-close-modal>Cancel</button><button class="button primary">Add task</button></div></form></section></div>
