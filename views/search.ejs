<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Find tasks, goals, projects, habits, and notes in one calm search.</p></div></div><section class="panel inline-form-panel"><form class="quick-entity-form" method="get" action="/search"><input name="q" value="<%= q %>" placeholder="Search your workspace..." autofocus required><button class="button primary">Search</button></form></section><% if(q){ %><p class="muted search-summary">Results for “<strong><%= q %></strong>”</p><% const groups=[['Tasks',results.tasks,'title','/tasks'],['Projects',results.projects,'name','/projects'],['Goals',results.goals,'title','/goals'],['Habits',results.habits,'name','/habits'],['Notes',results.notes,'title','/notes']]; groups.forEach(([label,items,field,href])=>{ if(items.length){ %><section class="panel search-group"><div class="panel-heading"><div><span class="eyebrow"><%= label %></span><h2><%= items.length %> match<%= items.length===1?'':'es' %></h2></div><a href="<%= href %>" class="text-link">Open section <i data-lucide="arrow-up-right"></i></a></div><div class="search-results"><% items.slice(0,8).forEach(item=>{ %><a class="search-result" href="<%= href %>"><span class="result-icon"><i data-lucide="search"></i></span><span><strong><%= item[field] %></strong><small><%= item.description||item.content||item.category||'Open to view details' %></small></span><i data-lucide="chevron-right"></i></a><% }) %></div></section><% } }) %><% if(!results.tasks.length&&!results.projects.length&&!results.goals.length&&!results.habits.length&&!results.notes.length){ %><div class="empty-state"><span class="empty-icon"><i data-lucide="search-x"></i></span><h3>No matches yet</h3><p>Try a shorter phrase or search for a project, task, or goal.</p></div><% } %><% } else { %><div class="empty-state"><span class="empty-icon"><i data-lucide="scan-search"></i></span><h3>Search your workspace</h3><p>Use the command palette or enter a phrase above to find anything you have captured.</p></div><% } %></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script></body></html>
