<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Keep the thinking close to the doing.</p></div><button class="button primary" data-open-inline="note-form"><i data-lucide="plus"></i> New note</button></div><section id="note-form" class="panel inline-form-panel hidden"><form class="quick-entity-form note-form" data-entity="note"><input name="title" placeholder="Note title" required><textarea name="content" placeholder="Write a thought, idea, or meeting note..."></textarea><input name="tags" placeholder="Tags, comma separated"><button class="button primary">Save note</button></form></section><div class="notes-grid"><% if(!notes.length){ %><div class="panel empty-state"><span class="empty-icon"><i data-lucide="notebook-pen"></i></span><h3>Your thinking space is empty</h3><p>Capture ideas before they disappear.</p></div><% } notes.forEach(note=>{ %><article class="note-card panel"><div class="note-card-top"><span class="note-icon"><i data-lucide="file-text"></i></span><small><%= new Date(note.updatedAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></small></div><h2><%= note.title %></h2><p><%= note.content||'No content yet.' %></p><div class="tag-row"><% (note.tags||[]).forEach(tag=>{ %><span class="tag">#<%= tag %></span><% }) %></div></article><% }) %></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/entities.js"></script></body></html>