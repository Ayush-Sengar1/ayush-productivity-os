<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Connect daily action to a direction worth pursuing.</p></div><button class="button primary" data-open-inline="goal-form"><i data-lucide="plus"></i> New goal</button></div><section id="goal-form" class="panel inline-form-panel hidden"><form class="quick-entity-form" data-entity="goal"><input name="title" placeholder="Goal title, e.g. Get a software development job" required><input name="category" placeholder="Category" value="Career"><input type="date" name="targetDate"><button class="button primary">Create goal</button></form></section><div class="goal-cards"><% if(!goals.length){ %><div class="panel empty-state"><span class="empty-icon"><i data-lucide="target"></i></span><h3>Give your work a north star</h3><p>Goals turn a collection of tasks into a meaningful journey.</p></div><% } goals.forEach(goal=>{ %><article class="goal-card panel"><div class="goal-card-heading"><span class="goal-symbol large"><i data-lucide="target"></i></span><div><span class="eyebrow"><%= goal.category %></span><h2><%= goal.title %></h2></div><span class="priority-pill <%= goal.priority %>"><%= goal.priority %></span></div><p><%= goal.description||'Add a description to make the outcome concrete.' %></p><div class="goal-progress-label"><span>Progress</span><strong><%= goal.progress||0 %>%</strong></div><div class="progress-track tall"><span style="width:<%= goal.progress||0 %>%"></span></div><div class="goal-card-footer"><span><i data-lucide="calendar"></i><%= goal.targetDate?new Date(goal.targetDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}):'No target date' %></span><span class="status-label <%= goal.status %>"><%= goal.status %></span></div></article><% }) %></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/entities.js"></script></body></html>