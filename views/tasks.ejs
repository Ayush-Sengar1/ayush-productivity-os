<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Turn intention into visible progress.</p></div><button class="button primary" data-command="new-task"><i data-lucide="plus"></i> New task</button></div><div class="filter-bar"><button class="filter active" data-task-filter="all">All</button><button class="filter" data-task-filter="todo">To do</button><button class="filter" data-task-filter="in_progress">In progress</button><button class="filter" data-task-filter="completed">Completed</button><span class="filter-spacer"></span><button class="filter-icon" data-command="search"><i data-lucide="search"></i> Search</button></div><section class="panel task-page-panel"><div id="task-page-list" class="task-page-list"><% if(!tasks.length){ %><div class="empty-state"><span class="empty-icon"><i data-lucide="inbox"></i></span><h3>Your task list is clear</h3><p>Capture the next thing you want to move forward.</p><button class="button primary" data-command="new-task">Create your first task</button></div><% } tasks.forEach(task=>{ %><div class="task-card" data-status="<%= task.status %>" data-task-card="<%= task._id %>"><button class="task-check <%= task.status==='completed'?'done':'' %>" data-task-id="<%= task._id %>"><i data-lucide="check"></i></button><div class="task-card-main"><strong><%= task.title %></strong><p><%= task.description||'No description yet.' %></p><div class="task-card-meta"><span class="priority-pill <%= task.priority %>"><%= task.priority %></span><% if(task.dueDate){ %><span><i data-lucide="calendar"></i><%= new Date(task.dueDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span><% } %><% if(task.tags?.length){ %><span><i data-lucide="tag"></i><%= task.tags.join(', ') %></span><% } %></div></div><button class="icon-button task-delete" data-delete-task="<%= task._id %>"><i data-lucide="trash-2"></i></button></div><% }) %></div></section></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/tasks.js"></script></body></html>