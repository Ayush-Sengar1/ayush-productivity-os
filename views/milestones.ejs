<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Turn ambitious projects into visible checkpoints.</p></div><button class="button primary" data-open-inline="milestone-form"><i data-lucide="plus"></i> New milestone</button></div><section id="milestone-form" class="panel inline-form-panel hidden"><form class="quick-entity-form" data-entity="milestone"><input name="title" placeholder="Milestone title, e.g. Authentication complete" required><input name="dueDate" type="date"><select name="project"><option value="">No project</option><% projects.forEach(project=>{ %><option value="<%= project._id %>"><%= project.name %></option><% }) %></select><select name="goal"><option value="">No goal</option><% goals.forEach(goal=>{ %><option value="<%= goal._id %>"><%= goal.title %></option><% }) %></select><button class="button primary">Create milestone</button></form></section><div class="milestone-list"><% if(!milestones.length){ %><div class="panel empty-state"><span class="empty-icon"><i data-lucide="flag"></i></span><h3>Choose your next checkpoint</h3><p>Milestones make large goals feel concrete. Link tasks to them as you build.</p></div><% } milestones.forEach(item=>{ %><article class="panel milestone-card"><div class="milestone-icon"><i data-lucide="flag"></i></div><div class="milestone-main"><div class="milestone-heading"><div><span class="eyebrow"><%= item.status %></span><h2><%= item.title %></h2></div><strong><%= item.calculatedProgress %>%</strong></div><div class="progress-track tall"><span style="width:<%= item.calculatedProgress %>%"></span></div><div class="milestone-footer"><span><i data-lucide="list-checks"></i><%= item.completedCount %>/<%= item.taskCount %> linked tasks</span><span><i data-lucide="calendar"></i><%= item.dueDate?new Date(item.dueDate).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}):'No due date' %></span></div></div></article><% }) %></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/entities.js"></script></body></html>
