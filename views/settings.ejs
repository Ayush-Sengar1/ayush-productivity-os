<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Make Focus fit the way you work.</p></div></div><div class="settings-grid"><section class="panel settings-card"><div class="panel-heading"><div><span class="eyebrow">Profile</span><h2>Your workspace</h2></div></div><div class="settings-profile"><span class="avatar large"><%= (currentUser?.name||'A').slice(0,1).toUpperCase() %></span><div><strong><%= currentUser?.name %></strong><span><%= currentUser?.email %></span></div></div><div class="settings-row"><div><strong>Appearance</strong><small>Choose how Focus feels on your screen.</small></div><select><option>System</option><option>Light</option><option>Dark</option></select></div><div class="settings-row"><div><strong>Default task duration</strong><small>Used when estimating new tasks.</small></div><select><option>30 minutes</option><option>45 minutes</option><option>60 minutes</option></select></div><div class="settings-row"><div><strong>Week starts on</strong><small>Used by calendar and analytics.</small></div><select><option>Monday</option><option>Sunday</option></select></div></section><section class="panel settings-card"><div class="panel-heading"><div><span class="eyebrow">Product principles</span><h2>Keep it useful</h2></div></div><div class="principle"><span><i data-lucide="sparkles"></i></span><div><strong>Clarity over clutter</strong><p>Every surface is designed to help you decide what matters next.</p></div></div><div class="principle"><span><i data-lucide="shield-check"></i></span><div><strong>Your data is yours</strong><p>Ownership checks are applied to every task, goal, project, habit, and note.</p></div></div><div class="principle"><span><i data-lucide="trending-up"></i></span><div><strong>Progress over perfection</strong><p>Analytics explain patterns so you can adjust the system with compassion.</p></div></div></section></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script></body></html>