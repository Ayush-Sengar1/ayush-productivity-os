<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Projects give your goals a place to become real.</p></div><button class="button primary" data-open-inline="project-form"><i data-lucide="plus"></i> New project</button></div><section id="project-form" class="panel inline-form-panel hidden"><form class="quick-entity-form" data-entity="project"><input name="name" placeholder="Project name" required><input name="deadline" type="date"><input name="color" type="color" value="#526dff"><button class="button primary">Create project</button></form></section><div class="project-grid"><% if(!projects.length){ %><div class="panel empty-state"><span class="empty-icon"><i data-lucide="folder-kanban"></i></span><h3>Start a project</h3><p>Group related tasks so progress becomes easy to see.</p></div><% } projects.forEach(project=>{ %><article class="project-card panel"><div class="project-accent" style="background:<%= project.color %>"></div><div class="project-card-content"><div class="project-card-heading"><span class="project-icon" style="color:<%= project.color %>;background:<%= project.color %>18"><i data-lucide="folder"></i></span><span class="status-label <%= project.status %>"><%= project.status %></span></div><h2><%= project.name %></h2><p><%= project.description||'No description yet.' %></p><div class="project-progress"><div class="project-progress-label"><span>Progress</span><strong><%= project.progress||0 %>%</strong></div><div class="progress-track"><span style="width:<%= project.progress||0 %>%;background:<%= project.color %>"></span></div></div><footer><span><i data-lucide="calendar"></i><%= project.deadline?new Date(project.deadline).toLocaleDateString('en-IN',{day:'numeric',month:'short'}):'No deadline' %></span><span><i data-lucide="list-checks"></i><%= project.taskCount||0 %> tasks</span></footer></div></article><% }) %></div></section></main></div><%- include('partials/flash') %><script src="/js/app.js"></script><script src="/js/entities.js"></script></body></html>