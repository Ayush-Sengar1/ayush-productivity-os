<%- include('partials/head') %><div class="layout"><%- include('partials/sidebar') %><main class="main"><%- include('partials/topbar') %><section class="content"><div class="page-intro"><div><p class="muted">Use data to improve the system, not to judge yourself.</p></div><span class="date-label"><i data-lucide="calendar"></i> Last 7 days</span></div><div id="analytics-loading" class="panel loading-state">Loading your patterns...</div><div id="analytics-content" class="hidden"><div class="analytics-hero panel"><div><span class="eyebrow">Transparent score</span><h2>Your productivity has a shape.</h2><p>Score is calculated from completed planned work, habit consistency, goal progress, and overdue tasks.</p></div><div class="hero-score"><strong id="score-value">—</strong><span>/100</span></div></div><div class="analytics-grid"><section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">Momentum</span><h2>Completed tasks</h2></div></div><canvas id="trend-chart" height="150"></canvas></section><section class="panel"><div class="panel-heading"><div><span class="eyebrow">Why this score</span><h2>Score breakdown</h2></div></div><div id="breakdown" class="breakdown-list"></div></section></div><div class="analytics-grid bottom"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">Execution</span><h2>Useful signals</h2></div></div><div class="signal-grid"><div><strong id="completion-rate">—</strong><span>Completion rate</span></div><div><strong id="overdue-count">—</strong><span>Overdue tasks</span></div><div><strong id="habit-rate">—</strong><span>Habit consistency</span></div></div></section><section class="panel"><div class="panel-heading"><div><span class="eyebrow">Direction</span><h2>Goal progress</h2></div><a href="/goals" class="text-link">Open goals <i data-lucide="arrow-up-right"></i></a></div><div id="goal-summary" class="goal-list"></div></section></div></div></section></main></div><%- include('partials/flash') %><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script><script src="/js/app.js"></script><script src="/js/analytics.js"></script></body></html>